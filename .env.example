# ==============================================================================
# LLM Evaluation Proxy & Gateway Environment Configuration
# ==============================================================================

# Application Settings
APP_NAME=llm-eval-proxy
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# Authentication & Security
# Toggle API key authentication requirement (true/false)
AUTH_ENABLED=true
# JSON dictionary mapping valid API keys to client / tenant names
GATEWAY_API_KEYS={"dev-key-001":"dev_service","tenant-alpha-key":"alpha_tenant"}

# Redis Stack & Semantic Vector Cache
# Redis Stack endpoint supporting RediSearch and vector index modules
REDIS_URL=redis://localhost:6379
# Semantic cache TTL in seconds (86400 = 24 hours)
CACHE_TTL_SECONDS=86400
# Maximum cosine distance threshold for cache hit (0.08 = high similarity)
CACHE_SIMILARITY_THRESHOLD=0.08

# Embeddings Service
# Embedding provider to use: 'local' (sentence-transformers) or custom
EMBEDDING_PROVIDER=local
# HuggingFace model name for sentence-transformers embedding generation
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# LLM Provider Credentials & Configuration
# Default LLM provider for incoming requests: 'mock', 'openai', 'anthropic', 'gemini'
DEFAULT_PROVIDER=mock
# Upstream provider API keys (optional if mock provider is active)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY= "AIzaSyDVZAhFw0Fe8XjW-thGKD1hrfQdAOuqI2c"

# Circuit Breaker & Resilience Configuration
# Consecutive failure count threshold to trip circuit to OPEN state
CB_FAILURE_THRESHOLD=5
# Time window in seconds across which failure count is tracked
CB_FAILURE_WINDOW_SECONDS=30
# Duration in seconds before an OPEN circuit transitions to HALF-OPEN
CB_COOLDOWN_SECONDS=60
# Fraction of requests allowed to probe upstream provider during HALF-OPEN state
CB_HALF_OPEN_PROBE_RATIO=0.10
# Individual upstream HTTP request timeout in milliseconds
CB_REQUEST_TIMEOUT_MS=8000

# Fallback & Failover Routing Chain
# JSON list of providers to attempt sequentially if primary provider fails or circuit opens
FALLBACK_CHAIN=["gemini","anthropic","openai"]
